---
import Eyebrow from "./Eyebrow.astro";

const clients = [
	"Farmacias Embon",
	"SCR",
	"Fedeli Buloneria",
	"ATM",
	"Adm Robas",
	"Borgonovo Publicidad",
	"Clinica Liryum",
	"Fundacion Villavicencio",
	"Lisicki Litvin y asociados",
	"Farmacia Paseo del Bosque",
	"Asociacion Familia Piamontesa",
	"Giacomo Propiedades",
	"Adm Roggero",
	"Adm Montenegro",
	"Cubus",
	"Vi-Car srl",
];
---

<section id="clientes" class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
	<div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
		<div>
			<Eyebrow label="Clientes" />
			<h2 class="font-heading text-2xl font-bold text-azul-profundo sm:text-3xl">Espacios que nos eligen.</h2>
		</div>
		</div>

	<div class="mt-12 grid gap-x-10 gap-y-2 md:gap-y-4 border-t border-celeste-niebla pt-6 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
		{
			clients.map((client) => (
				<p class="border-b border-celeste-niebla pb-6 text-sm font-semibold text-azul-profundo/50">{client}</p>
			))
		}
	</div>
</section>
