---
import Logo from "./Logo.astro";
---

<footer class="border-t border-celeste-niebla bg-white px-6 py-14 lg:px-8">
	<div class="mx-auto flex max-w-7xl flex-col items-center gap-6 text-center">
		<Logo src="/LogoCentrado.svg" imgClass="h-20 w-auto" />

		<p class="font-heading text-sm font-bold tracking-[0.2em] text-azul-profundo uppercase">
			Todo vuelve a brillar
		</p>

		<a href="#top" class="text-sm font-semibold text-turquesa transition-colors hover:text-azul-profundo">
			Volver al inicio
		</a>

		<div class="mt-8 flex flex-col items-center gap-1 border-t border-celeste-niebla pt-6 text-xs text-azul-profundo/50">
			<p>Oficinas, edificios y consorcios.</p>
			<p>Propuesta de identidad y experiencia web para Génesis Plus.</p>
		</div>
	</div>
</footer>
