---
import Logo from "./Logo.astro";

const links = [
	{ href: "#servicios", label: "Servicios" },
	{ href: "#nuestra-mirada", label: "Nuestra mirada" },
	{ href: "#como-empezar", label: "Cómo empezar" },
];
---

<header class="sticky top-0 z-50 border-b border-celeste-niebla bg-white/90 backdrop-blur">
	<div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4 lg:px-8">
		<Logo />

		<nav class="hidden items-center gap-8 md:flex">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="text-sm font-semibold text-azul-profundo/80 transition-colors hover:text-turquesa"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<a
			href="#contacto"
			class="inline-flex items-center gap-2 rounded-full bg-azul px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-azul-profundo"
		>
			Pedir presupuesto
			<span aria-hidden="true">↗</span>
		</a>
	</div>
</header>
