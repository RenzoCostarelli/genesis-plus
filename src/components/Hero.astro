---

---

<section
  class="relative flex min-h-160 items-center overflow-hidden lg:min-h-190"
>
  <img
    src="https://res.cloudinary.com/dztzomvin/image/upload/v1794400831/AdobeStock_804358854_ryb2lh.jpg"
    alt=""
    fetchpriority="high"
    loading="eager"
    class="absolute inset-0 h-full w-full object-cover"
  />

  <div
    class="absolute inset-0 bg-linear-to-r from-azul-profundo via-azul-profundo/55 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-6 py-24 lg:px-8 lg:py-0">
    <div class="flex max-w-xl flex-col gap-7">
      <h1
        class="font-heading text-4xl font-light tracking-[0.2em] text-white uppercase sm:text-5xl"
      >
        Todo vuelve a brillar
      </h1>

      <p class="max-w-md text-base text-white/90">
        Limpieza para oficinas, edificios y consorcios.
        <br />
        El cuidado de los espacios que compartimos todos los días.
      </p>

      <div class="mt-2 flex flex-wrap items-center gap-8">
        <a
          href="#contacto"
          class="inline-flex items-center gap-2 rounded-full bg-azul px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-azul-profundo"
        >
          Contanos qué necesitás
          <span aria-hidden="true">↗</span>
        </a>
        <a
          href="#servicios"
          class="text-sm font-semibold text-white underline decoration-white/40 underline-offset-4 transition-colors hover:decoration-white"
        >
          Conocé los servicios
        </a>
      </div>
    </div>
  </div>
</section>
