---
const steps = [
  {
    // number: "01",
    label: "Tu espacio",
    title: "Contanos qué necesitás",
    description:
      "Indicá si se trata de una oficina o un edificio y qué zona se encuentra.",
  },
  {
    // number: "02",
    label: "Los detalles",
    title: "Veamos el alcance",
    description:
      "Los ambientes, las tareas y la frecuencia ayudan a entender la necesidad de limpieza.",
  },
  {
    // number: "03",
    label: "La propuesta",
    title: "Definamos el servicio",
    description:
      "Con esa información se puede conversar sobre una propuesta para el lugar.",
  },
];
---

<section id="como-empezar" class="bg-hielo px-6 py-20 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div
      class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center"
    >
      <div>
        <p
          class="mb-3 text-xs font-bold tracking-[0.2em] text-turquesa uppercase"
        >
          Cómo empezar
        </p>
        <h2
          class="font-heading text-2xl font-bold text-azul-profundo sm:text-3xl"
        >
          Conversemos sobre tu espacio.
        </h2>
      </div>
      <a
        href="#contacto"
        class="inline-flex shrink-0 items-center gap-2 rounded-full bg-azul px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-azul-profundo"
      >
        Contanos qué necesitás
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="mt-14 grid gap-10 sm:grid-cols-3">
      {
        steps.map((step) => (
          <div>
            <h3 class="font-heading text-lg font-bold text-azul-profundo">
              {step.title}
            </h3>
            <p class="mt-2 text-sm text-azul-profundo/70">{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
