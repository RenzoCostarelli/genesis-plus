---
interface Props {
	src?: string;
	class?: string;
	imgClass?: string;
}

const { src = "/Logo.svg", class: className = "", imgClass = "h-10 w-auto" } = Astro.props;
---

<a href="#top" class:list={["inline-flex items-center", className]}>
	<img src={src} alt="Génesis Plus" class={imgClass} />
</a>
